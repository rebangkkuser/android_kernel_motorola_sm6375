CONFIG_QCOM_INITIAL_LOGBUF=y
CONFIG_QCOM_MINIDUMP_FTRACE=y
CONFIG_QCOM_MINIDUMP_PANIC_DUMP=y
CONFIG_QCOM_IRQ_STAT=y
CONFIG_PSTORE_PMSG=y
