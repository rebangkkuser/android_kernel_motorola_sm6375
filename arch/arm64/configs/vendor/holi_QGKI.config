CONFIG_QTI_HW_MEMLAT_LOG=y
CONFIG_MSM_PERFORMANCE=y
CONFIG_QTI_SCMI_PLH_PROTOCOL=y
CONFIG_QTI_PLH=y
CONFIG_QTI_PLH_SCMI_CLIENT=y
CONFIG_MSM_PERFORMANCE_QGKI=y
